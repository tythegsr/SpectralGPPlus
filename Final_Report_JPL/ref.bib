@Article{Bohn03172025,
AUTHOR = {Bohn, N. and Bair, E. H. and Brodrick, P. G. and Carmon, N. and Green, R. O. and Painter, T. H. and Thompson, D. R.},
TITLE = {Do we still need reflectance? From radiance to snow properties in mountainous terrain: a case study with the EMIT imaging spectrometer},
JOURNAL = {The Cryosphere},
VOLUME = {19},
YEAR = {2025},
NUMBER = {3},
PAGES = {1279--1302},
URL = {https://tc.copernicus.org/articles/19/1279/2025/},
