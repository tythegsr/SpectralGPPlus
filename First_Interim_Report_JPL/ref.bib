@article{Bohn25,
author = {Niklas Bohn and Evan Greenberg and Philip G. Brodrick and John Chapman and Regina Eckert and Michelle Gierach and Robert O. Green and Marcel K\"{o}nig and Jeremy Kravitz and Kelly Luis and Jouni Susiluoto and David R. Thompson},
journal = {Appl. Opt.},
keywords = {Atmospheric correction; Atmospheric properties; Ocean color; Optical properties; Remote sensing; Viewing angles},
number = {30},
pages = {9094--9105},
publisher = {Optica Publishing Group},
title = {Simultaneous modeling of water-leaving reflectance and sun and sky glint contributions from imaging spectroscopy measurements},
volume = {64},
month = {Oct},
year = {2025},
url = {https://opg.optica.org/ao/abstract.cfm?URI=ao-64-30-9094},
doi = {10.1364/AO.569763},
abstract = {Remote imaging spectroscopy, with its ability to quantify phytoplankton pigments, is a powerful tool for monitoring aquatic ecosystems, giving valuable insights into environmental processes. However, the accuracy of these retrievals is impacted by specular glint at the air--water interface. Current imaging spectrometer missions either ignore glint-contaminated pixels or apply post hoc corrections, which can introduce substantial uncertainties in reflectance estimates. To address this challenge, we present an approach that simultaneously models water-leaving reflectance and sun and sky glint contributions from imaging spectroscopy measurements. We reveal the accurate performance of our model by utilizing measurements and derived chlorophyll-a products from the PRISM airborne imaging spectrometer during the SubMesoscale Ocean Dynamics Experiment campaign.},
}

